# =============================================================================
# alt_celery3 — runtime configuration.
#
# Copy this file to `.env` and adapt the values before running:
#     cp .env.example .env
#
# Note: values containing special characters must be quoted, e.g.
#     CELERY_BROKER_URL='redis://:p@ss:word!@redis-stack:6379/0'
# =============================================================================

# --- Message broker / result backend ----------------------------------------
# Uses an EXISTING, password-protected redis-stack server. The host below
# must be reachable from wherever the app runs:
#   * local development  -> 127.0.0.1 (or your redis-stack host)
#   * inside Docker      -> LAN IP / docker host gateway /
#                           host.docker.internal / redis-stack service name
CELERY_BROKER_URL=redis://:your-redis-password@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:your-redis-password@127.0.0.1:6379/1

# --- Celery behaviour --------------------------------------------------------
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=false
# Run tasks in-process without broker/worker (offline demos and tests only).
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
# Seconds after which finished results expire in the result backend.
CELERY_RESULT_EXPIRES=86400
# Number of worker processes (used by docker-compose; default 2).
CELERY_WORKER_CONCURRENCY=2

# --- Example beat (periodic) task -------------------------------------------
# Register the example periodic task in the celery-beat schedule.
CELERY_ENABLE_EXAMPLE_BEAT=true
# Dispatch the example periodic task every N minutes.
CELERY_EXAMPLE_BEAT_MINUTES=30

# --- Flower (monitoring UI) -------------------------------------------------
# Host port exposed by the Flower service (docker-compose; default 5555).
FLOWER_PORT=5555
# user:password protecting the Flower dashboard (recommended, change me!)
FLOWER_BASIC_AUTH=admin:change-me

# --- MySQL web_db (tasks.db.try_mysql / tasks.db.get_one_student) ------------
MYSQL_WEB_HOST=127.0.0.1
MYSQL_WEB_PORT=3306
MYSQL_WEB_USER=web_user
MYSQL_WEB_PASSWORD=change-me
MYSQL_WEB_DATABASE=web_db

# --- sclog-lite MySQL backend (operation log database) -----------------------
SCLOG_MYSQL_HOST=127.0.0.1
SCLOG_MYSQL_PORT=3306
SCLOG_MYSQL_USER=log_user
SCLOG_MYSQL_PASSWORD=change-me
SCLOG_MYSQL_DATABASE=log_db
SCLOG_MYSQL_TABLE=sclog_entries
# Set to false to disable the MySQL log backend (console/file logging only).
SCLOG_MYSQL_ENABLED=true
